# Copy the backend section to backend/.env
# Copy the frontend section to frontend/.env

# =========================
# Backend
# =========================
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/license_plate_recognition
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
REFRESH_COOKIE_NAME=vietplate_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
BOOTSTRAP_ADMIN_EMAIL=admin@vietplate.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
WARM_MODEL_ON_STARTUP=true

# =========================
# Frontend
# =========================
VITE_API_BASE_URL=http://127.0.0.1:8000
